{
  "version": 1,
  "cuenta": {
    "proveedor": "gmail-api",
    "servidor": "imap.gmail.com",
    "puerto": 993,
    "usuario_env": "GMAIL_USUARIO",
    "password_env": "GMAIL_APP_PASSWORD",
    "carpeta_entrada": "INBOX",
    "carpeta_spam": "[Gmail]/Spam",
    "carpeta_papelera": "[Gmail]/Trash",
    "credenciales_api": "credentials.json",
    "token_api": "token.json"
  },
  "ia": {
    "url_env": "CENTRO_IA_URL",
    "clave_env": "CENTRO_IA_KEY",
    "modelo_env": "CENTRO_IA_MODELO",
    "ca_env": "CENTRO_IA_CA",
    "modelo_por_defecto": "qwen3.8-flash-next"
  },
  "acciones": [
    {
      "nombre": "resumen-24h",
      "descripcion": "Resume con IA el contenido de los correos de las últimas 24 horas",
      "tipo": "resumen-ia",
      "horas": 24
    },
    {
      "nombre": "revisar-24h",
      "descripcion": "Revisa uno a uno los correos de las últimas 24 h y borra los que no interesen",
      "tipo": "revisar",
      "carpeta": "entrada",
      "horas": 24
    },
    {
      "nombre": "listar-spam",
      "descripcion": "Lista todos los mensajes de la carpeta de spam",
      "tipo": "listar",
      "carpeta": "spam"
    },
    {
      "nombre": "limpiar-spam",
      "descripcion": "Mueve toda la bandeja de spam a la papelera de Gmail",
      "tipo": "mover-papelera",
      "carpeta": "spam",
      "confirmar": true
    },
    {
      "nombre": "guardar-resumen",
      "descripcion": "Guarda el resumen de las últimas 24 horas en un fichero Markdown",
      "tipo": "exportar",
      "horas": 24,
      "destino": "~/resumenes"
    },
    {
      "nombre": "limpiar-prescindibles",
      "descripcion": "La IA clasifica los correos de las últimas 24 h y propone mover a la papelera publicidad y boletines",
      "tipo": "clasificar-ia",
      "carpeta": "entrada",
      "horas": 24
    }
  ]
}
