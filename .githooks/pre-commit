#!/bin/sh
# Bloquea el commit si se intenta subir un secreto (aunque se haya hecho «git add -f»).
# Se activa una vez por clon con:  git config core.hooksPath .githooks

prohibidos='(^|/)(\.env(\..*)?|credentials[^/]*\.json|client_secret[^/]*\.json|token[^/]*\.json|[^/]*\.(pem|key|p12))$'

ficheros=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$prohibidos" | grep -v -E '(^|/)\.env\.example$')

if [ -n "$ficheros" ]; then
    echo "ERROR: estos ficheros tienen secretos y no se pueden subir a git:" >&2
    echo "$ficheros" | sed 's/^/  - /' >&2
    echo "Quítalos con:  git restore --staged <fichero>" >&2
    exit 1
fi

# Contenido sospechoso en cualquier fichero: claves de cliente OAuth y tokens de Google.
if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -q -E 'GOCSPX-[A-Za-z0-9_-]{10,}|ya29\.[A-Za-z0-9_-]{20,}|"1//[A-Za-z0-9_-]{20,}'; then
    echo "ERROR: el commit contiene algo que parece una clave o token de Google." >&2
    echo "Revisa los cambios con:  git diff --cached" >&2
    exit 1
fi

exit 0
