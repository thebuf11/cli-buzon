# Copia este fichero a .env y rellena tus datos.
# .env está en .gitignore: nunca se sube al repositorio.

# --- Gmail ---
# Tu dirección completa, por ejemplo: alumno@gmail.com
GMAIL_USUARIO=
# Contraseña de APLICACIÓN de 16 caracteres (no la de tu cuenta).
# Actívala en: Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones.
GMAIL_APP_PASSWORD=

# --- Capa IA (servicio compatible con OpenAI: POST /v1/chat/completions) ---
# Si dejas IA_API_URL vacía, la CLI funciona igual: avisa y sigue sin resumen IA.
IA_API_URL=
IA_API_KEY=
IA_MODELO=llama3
